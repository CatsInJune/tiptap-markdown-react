{
  "name": "tiptap-markdown-react",
  "version": "1.21.0",
  "description": "A batteries-included, self-styled Markdown WYSIWYG editor and reader suite built on Tiptap v3. Markdown in/out, SSR/static rendering, table of contents, themeable via CSS variables.",
  "type": "module",
  "license": "MIT",
  "author": "CatsInJune",
  "homepage": "https://github.com/CatsInJune/tiptap-markdown-react#readme",
  "bugs": {
    "url": "https://github.com/CatsInJune/tiptap-markdown-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CatsInJune/tiptap-markdown-react.git"
  },
  "keywords": [
    "tiptap",
    "markdown",
    "editor",
    "wysiwyg",
    "rich-text",
    "react",
    "prosemirror",
    "ssr",
    "table-of-contents"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "THIRD_PARTY_LICENSES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./reader": {
      "types": "./dist/reader.d.ts",
      "import": "./dist/reader.js"
    },
    "./style.css": "./dist/style.css",
    "./style-inline.css": "./dist/style-inline.css"
  },
  "scripts": {
    "build": "vite build && node scripts/split-fonts.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-code": "3.34.0",
    "@tiptap/extension-code-block-lowlight": "3.34.0",
    "@tiptap/extension-details": "3.34.0",
    "@tiptap/extension-drag-handle": "3.34.0",
    "@tiptap/extension-drag-handle-react": "3.34.0",
    "@tiptap/extension-emoji": "3.34.0",
    "@tiptap/extension-file-handler": "3.34.0",
    "@tiptap/extension-find-and-replace": "3.34.0",
    "@tiptap/extension-heading": "3.34.0",
    "@tiptap/extension-highlight": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-mathematics": "3.34.0",
    "@tiptap/extension-node-range": "3.34.0",
    "@tiptap/extension-paragraph": "3.34.0",
    "@tiptap/extension-subscript": "3.34.0",
    "@tiptap/extension-superscript": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-table-of-contents": "3.34.0",
    "@tiptap/extension-task-item": "3.34.0",
    "@tiptap/extension-task-list": "3.34.0",
    "@tiptap/extension-text-align": "3.34.0",
    "@tiptap/extension-text-style": "3.34.0",
    "@tiptap/extension-typography": "3.34.0",
    "@tiptap/extension-unique-id": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/static-renderer": "3.34.0",
    "@tiptap/suggestion": "3.34.0",
    "chart.js": "^4.5.1",
    "emoji-regex": "10.6.0",
    "katex": "^0.16.47",
    "lowlight": "3.3.0",
    "marked": "^17.0.1",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^18.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rollup-preserve-directives": "^1.1.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@tiptap/core": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-details": "3.34.0",
    "@tiptap/extension-file-handler": "3.34.0",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3",
    "@tiptap/extension-drag-handle": "3.34.0",
    "@tiptap/extension-drag-handle-react": "3.34.0",
    "@tiptap/extension-node-range": "3.34.0",
    "re2js": "2.8.8"
  }
}
